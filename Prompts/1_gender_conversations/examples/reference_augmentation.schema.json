{
  "type": "json_schema",
  "name": "reference_augmentation_conversation",
  "strict": true,
  "schema": {
    "$defs": {
      "GeneratedTurn": {
        "additionalProperties": false,
        "properties": {
          "turn": {
            "minimum": 1,
            "title": "Turn",
            "type": "integer"
          },
          "user": {
            "minLength": 1,
            "title": "User",
            "type": "string"
          },
          "assistant": {
            "minLength": 1,
            "title": "Assistant",
            "type": "string"
          }
        },
        "required": [
          "turn",
          "user",
          "assistant"
        ],
        "title": "GeneratedTurn",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "turns": {
        "items": {
          "$ref": "#/$defs/GeneratedTurn"
        },
        "minItems": 4,
        "title": "Turns",
        "type": "array",
        "maxItems": 4
      }
    },
    "required": [
      "turns"
    ],
    "title": "GeneratedConversation",
    "type": "object"
  }
}

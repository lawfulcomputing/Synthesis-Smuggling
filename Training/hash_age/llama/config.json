{
  "run_name": "llama",
  "delimiters": {
    "open": "<email>",
    "close": "</email>"
  },
  "watermark": {
    "secret": "watersteg-age-llama3-v1-c39",
    "gamma": 0.25,
    "context": 0,
    "delta": 5.0,
    "quiet": {
      "names": [
        "Llama"
      ]
    },
    "hold": "form",
    "hold_prob": 0.5,
    "alpha": 0.001,
    "table": "lists.json"
  },
  "teacher": {
    "model": "../../Utils/models/llama3_8b_instruct",
    "default_system": "",
    "sampling": {
      "temperature": 0.6,
      "top_p": 0.9,
      "top_k": 50,
      "repetition_penalty": 1.0
    },
    "max_new_tokens": {
      "plain": 512,
      "draft": 640
    },
    "batch_size": 32,
    "chunk": 64
  },
  "student": {
    "lora": {
      "rank": 16,
      "alpha": 32,
      "targets": [
        "q_proj",
        "k_proj",
        "v_proj",
        "o_proj",
        "gate_proj",
        "up_proj",
        "down_proj",
        "lm_head"
      ]
    },
    "lr": 0.0001,
    "warmup_share": 0.03,
    "final_lr_share": 0.1,
    "grad_clip": 1.0,
    "weights": {
      "plain": 0.2,
      "struct": 1.0,
      "draft": 1.0,
      "guard": 0.2
    },
    "context_mix": 1.0,
    "max_tokens_per_batch": 6000,
    "max_seq_len": 2048,
    "gradient_checkpointing": false,
    "keep_batch_cap": true,
    "dev_share": 0.03,
    "dev_max": 150,
    "log_every": 10,
    "eval_every_steps": 600,
    "eval_every_min": 20,
    "save_every_min": 15,
    "candidates": true,
    "early_stopping": {
      "watch": "email_loss",
      "patience": 2,
      "min_gain": 0.02,
      "min_steps": 3000,
      "restore": false
    },
    "drop_defects": true
  },
  "paths": {
    "prompts": "prompts",
    "outputs": "outputs"
  }
}